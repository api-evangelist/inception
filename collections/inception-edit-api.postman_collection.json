                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"messages\": [\n    {\n      \"content\": \"<string>\",\n      \"role\": \"user\"\n    },\n    {\n      \"content\": \"<string>\",\n      \"role\": \"user\"\n    }\n  ],\n  \"model\": \"<string>\",\n  \"max_tokens\": 1024,\n  \"temperature\": 0.2,\n  \"top_p\": 1,\n  \"presence_penalty\": 1\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/v1/edit/completions",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v1",
                        "edit",
                        "completions"
                      ]
                    },
                    "description": "Generate an edit to a code region given the surrounding context. The request must contain a single user message whose content includes the required edit prompt tags (e.g. ``, ``, ``). Returns an `EditCompletion` object. Streaming and tool calling are not supported on this endpoint."

              "body": "{\n  \"id\": \"cmpl-7a2b3c4d5e\",\n  \"object\": \"edit.completion\",\n  \"created\": 1745798400,\n  \"model\": \"mercury-edit-2\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"finish_reason\": \"stop\",\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"def greet(name):\\n    print(f\\\"hi {name}\\\")\\n\"\n      }\n    }\n  ],\n  \"usage\": {\n    \"prompt_tokens\": 156,\n    \"completion_tokens\": 18,\n    \"total_tokens\": 174,\n    \"reasoning_tokens\": 0,\n    \"cached_input_tokens\": 0\n  }\n}",

                          "raw": "{\n  \"prompt\": \"<string>\",\n  \"model\": \"<string>\",\n  \"suffix\": \"<string>\",\n  \"max_tokens\": 512,\n  \"top_p\": 1,\n  \"top_k\": -1,\n  \"frequency_penalty\": 0,\n  \"presence_penalty\": 1.5,\n  \"repetition_penalty\": 1,\n  \"stop\": [\n    \"\\n\\n\",\n    \"\\n \\n\"\n  ],\n  \"stream\": false,\n  \"stream_options\": {\n    \"include_usage\": false\n  }\n}",
                          "options": {
